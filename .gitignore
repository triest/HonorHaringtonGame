project/.godot/
*.tmp
Claude outputs/*.py

_to_delete/

# Persisted deploy key for the scheduled task's device_bash VM (each cron
# firing gets a fresh ephemeral VM with no SSH key of its own -- see
# ARCHITECTURE.md). NEVER commit this; restored into ~/.ssh at the start
# of each scheduled run instead.
.git-deploy-key/
.idea/

# Persistent local Godot binary cache (downloaded once, kept on user's disk).
# state.md is the exception -- it's the small machine-resume pointer the
# honorverse-dev-pass skill reads/writes every pass and explicitly commits;
# only the (large, re-downloadable) binary itself should be ignored.
.tools/*
!.tools/state.md

# Windows export output (large binary, re-buildable via
# `godot --headless --export-release "Windows Desktop" project/build/HonorHarington.exe`
# once export templates are cached -- see .tools/godot_templates_cache/).
project/build/

# Scratch files from ad-hoc headless/Xvfb diagnostic probes (throwaway,
# not part of the game or the test suite -- see simulation/tests/ for the
# committed regression tests these probes led to).
project/dev_probe_tmp/
project/probe.log
